# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (the app was built against Neon's serverless driver).
# If your provider rotates the password, fetch a fresh URI rather than caching an old one.
DATABASE_URL=

# Google OAuth client credentials. The authorized redirect URI in Google Cloud must be
# <your origin>/api/auth/callback/google exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session JWT. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of the Google account emails allowed to sign in.
# Leaving it unset or empty locks everyone out rather than letting everyone in:
# the gate fails closed on purpose. See lib/allowlist.ts.
CURATOR_ALLOWED_EMAILS=

# TMDB v3 API key. Needed only by /api/search, which backs the Add flow's autocomplete.
# Poster images load from image.tmdb.org without a key.
# Unset means a degraded Add flow, not a broken app: /api/search returns 502, the form
# reports that search is unavailable, and free-text entry still stages the title.
TMDB_API_KEY=
